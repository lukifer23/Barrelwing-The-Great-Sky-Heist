{
  "name": "barrelwing",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "An offline squirrel-courier action platformer for Android and WebGL browsers, with barrel dodging, windtail flight, upgrades, and saved progress.",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/build-assets.mjs",
    "test": "tsx --test tests/content.test.ts",
    "test:browser": "playwright test",
    "check": "npm run test && npm run build && npm run test:browser",
    "icons": "node scripts/build-icons.mjs",
    "android:apk": "node scripts/android.mjs build",
    "android:install": "node scripts/android.mjs install"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.65.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lukifer23/Barrelwing-The-Great-Sky-Heist.git"
  },
  "homepage": "https://github.com/lukifer23/Barrelwing-The-Great-Sky-Heist#readme",
  "bugs": {
    "url": "https://github.com/lukifer23/Barrelwing-The-Great-Sky-Heist/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
